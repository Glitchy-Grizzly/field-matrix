{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dev: Start & Open Browser",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Start Vite Dev Server",
        "Open Built-in Browser"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Start Vite Dev Server",
      "type": "shell",
      "command": "npm run dev",
      "isBackground": true,
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^([^\\s].*)\\((\\d+,\\d+)\\):\\s+(error|warning)\\s+(TS\\d+)\\s*:\\s*(.*)$",
          "file": 1,
          "location": 2,
          "severity": 3,
          "code": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE\\s+v|hmr update|page reload",
          "endsPattern": "Local:\\s+https?://localhost:\\d+"
        }
      }
    },
    {
      "label": "Open Built-in Browser",
      "type": "shell",
      "command": "echo",
      "args": [
        "Opened http://localhost:5173 in built-in browser",
        "${input:openSimpleBrowser}"
      ],
      "presentation": {
        "reveal": "never",
        "close": true
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "openSimpleBrowser",
      "type": "command",
      "command": "simpleBrowser.show",
      "args": [
        "http://localhost:5173"
      ]
    }
  ]
}
